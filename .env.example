# Copy to .env and fill in. Semantics reads these via python-dotenv.

# --- Model / provider ------------------------------------------------------
# Any litellm-style model string: "anthropic/claude-sonnet-4-6", "openai/gpt-5",
# "ollama/qwen2.5-coder", "openrouter/..." etc.
SEMANTICS_MODEL_NAME=anthropic/claude-sonnet-4-6
SEMANTICS_API_KEY=
# Fallback if SEMANTICS_API_KEY is unset and you're using an Anthropic model:
ANTHROPIC_API_KEY=
# Fallback for OpenAI-family models:
OPENAI_API_KEY=
# Only needed for self-hosted / proxy endpoints (e.g. a local Ollama server):
SEMANTICS_BASE_URL=

# --- Agent behaviour ---------------------------------------------------------
SEMANTICS_MAX_ITERATIONS=25
SEMANTICS_MAX_CONTEXT_TOKENS=100000
SEMANTICS_AUTO_APPROVE=true
SEMANTICS_BASH_TIMEOUT=60
SEMANTICS_PROJECT_ROOT=.

# --- UI ----------------------------------------------------------------------
# Set to false to always use plain-text (--no-tui) mode.
SEMANTICS_TUI=true

# --- Pro licensing -------------------------------------------------------------
# Issue keys with: python tools/generate_license.py issue --to "you"
SEMANTICS_LICENSE_KEY=
SEMANTICS_LICENSED_TO=
# Only set this if you're bundling a public key outside of
# src/pro/license_public_key.pem (e.g. injecting it at deploy time).
SEMANTICS_PUBLIC_KEY_PEM=

# --- Pro sub-agents ------------------------------------------------------------
SEMANTICS_PICO_BINARY=picoclaw
